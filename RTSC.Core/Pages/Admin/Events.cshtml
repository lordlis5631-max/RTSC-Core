@page
@model RTSC.Core.Pages.Admin.EventsModel
@{ ViewData["Title"] = "Модерация мероприятий"; }
<div class="page-head"><div><p class="eyebrow">Админ</p><h1>Мероприятия</h1></div></div>
<div class="table-wrap"><table><thead><tr><th>Мероприятие</th><th>Сообщество</th><th>Дата</th><th>Статус</th><th>Действия</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td><a href="/Events/@item.Id"><strong>@item.Title</strong></a></td><td>@item.CommunityName</td><td>@item.StartAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td><td><span class="badge">@item.Status</span></td><td><div class="actions compact"><form method="post" asp-page-handler="Status"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="status" value="Published"/><button class="link-button" type="submit">Опубликовать</button></form><form method="post" asp-page-handler="Status"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="status" value="Draft"/><button class="link-button danger" type="submit">Вернуть</button></form></div></td></tr> }</tbody></table></div>
