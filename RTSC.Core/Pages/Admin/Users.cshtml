@page
@model RTSC.Core.Pages.Admin.UsersModel
@{ ViewData["Title"] = "Пользователи"; }
<div class="page-head"><div><p class="eyebrow">Админ</p><h1>Пользователи</h1></div></div>
<form method="get" class="row-form"><input name="q" value="@Model.Query" placeholder="Имя или email"/><button class="button secondary" type="submit">Найти</button></form>
<div class="table-wrap"><table><thead><tr><th>Имя</th><th>Email</th><th>Роль</th><th>Статус</th><th>Действия</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.Name</td><td>@item.Email</td><td><span class="badge">@item.Role</span></td><td>@item.Status</td><td><div class="actions compact"><form method="post" asp-page-handler="ToggleBlock"><input type="hidden" name="id" value="@item.Id"/><button class="link-button" type="submit">@(item.Status == "Active" ? "Заблокировать" : "Разблокировать")</button></form>@if (User.IsInRole("SuperAdmin")) { <form method="post" asp-page-handler="Role"><input type="hidden" name="id" value="@item.Id"/><select name="role"><option>User</option><option>Admin</option><option>SuperAdmin</option></select><button class="link-button" type="submit">Сменить роль</button></form> }</div></td></tr> }</tbody></table></div>
