@page
@model RTSC.Core.Pages.LoginModel
@{
    ViewData["Title"] = "Вход";
}
<h1>Вход</h1>
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p class="error">@Model.Error</p>
}
<form method="post" class="form">
    <label>Email<input asp-for="Email" type="email" required /></label>
    <label>Пароль<input asp-for="Password" type="password" required /></label>
    <button class="button" type="submit">Войти</button>
</form>
