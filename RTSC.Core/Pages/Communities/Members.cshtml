@page "/Communities/{id:guid}/Members"
@model RTSC.Core.Pages.Communities.MembersModel
@{
    ViewData["Title"] = "Участники сообщества";
}
<div class="page-head">
    <div>
        <p class="eyebrow">Управление сообществом</p>
        <h1>@Model.CommunityName</h1>
        <p class="muted">Владелец может назначать и снимать администраторов.</p>
    </div>
    <div class="actions">
        <a class="button secondary" href="/Communities/@Model.CommunityId">Вернуться в сообщество</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <p class="notice">@Model.Message</p>
}

<section class="card">
    <h2>Назначить администратора</h2>
    <form method="post" asp-page-handler="AddAdmin" class="row-form">
        <input asp-for="AdminEmail" type="email" placeholder="Email зарегистрированного пользователя" required />
        <div></div>
        <button class="button" type="submit">Назначить</button>
    </form>
</section>

<section class="section">
    <h2>Состав сообщества</h2>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Имя</th><th>Email</th><th>Роль</th><th>С нами с</th><th></th></tr></thead>
            <tbody>
            @foreach (var member in Model.Members)
            {
                <tr>
                    <td>@member.Name</td>
                    <td>@member.Email</td>
                    <td><span class="badge">@member.Role</span></td>
                    <td>@member.JoinedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                    <td>
                        @if (member.Role == "Admin")
                        {
                            <form method="post" asp-page-handler="RemoveAdmin">
                                <input type="hidden" name="userId" value="@member.UserId" />
                                <button class="link-button danger" type="submit">Снять права</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
