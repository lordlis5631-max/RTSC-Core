@page "/My"
@model RTSC.Core.Pages.My.IndexModel
@{
    ViewData["Title"] = "Мой RTSC";
}

<div class="page-head dashboard-head">
    <div>
        <p class="eyebrow">Личный кабинет</p>
        <h1>Мой RTSC</h1>
        <p class="muted">Здравствуйте, @Model.DisplayName. Здесь собраны ваши мероприятия и быстрые действия.</p>
    </div>
    <div class="actions">
        <a class="button" href="/Events">Найти мероприятие</a>
        <a class="button secondary" href="/My/Interests">Мои интересы</a>
        <a class="button secondary" href="/Profile">Профиль и уведомления</a>
    </div>
</div>

<div class="grid stats dashboard-stats">
    <article><strong>@Model.Stats.Upcoming</strong><span>ближайших</span></article>
    <article><strong>@Model.Stats.Registrations</strong><span>регистраций</span></article>
    <article><strong>@Model.Stats.Attended</strong><span>посещено</span></article>
    <article><strong>@Model.Stats.ManagedCommunities</strong><span>сообществ в управлении</span></article>
    <article><strong>@Model.Stats.PerformerAssignments</strong><span>назначений исполнителем</span></article>
    <article><strong>@Model.Stats.UnreadNotifications</strong><span>непрочитанных уведомлений</span></article>
</div>

<section class="section recommendation-section">
    <div class="page-head mini">
        <div><h2>Рекомендуем вам</h2><p class="muted">Подборка строится только по выбранным вами категориям и тегам.</p></div>
        <a class="link-button" href="/My/Interests">Настроить интересы</a>
    </div>
    @if (!Model.HasInterests)
    {
        <div class="card empty-dashboard">
            <h3>Расскажите, что вам интересно</h3>
            <p>Выберите категории и теги — после этого здесь появится персональная подборка мероприятий.</p>
            <a class="button" href="/My/Interests">Выбрать интересы</a>
        </div>
    }
    else if (Model.Recommendations.Count == 0)
    {
        <div class="card empty-dashboard"><p>Сейчас нет новых опубликованных мероприятий, совпадающих с вашими интересами.</p><a class="button secondary" href="/Events">Открыть всю афишу</a></div>
    }
    else
    {
        <div class="cards dashboard-cards recommendation-cards">
        @foreach (var item in Model.Recommendations)
        {
            <article class="card recommendation-card">
                <p class="eyebrow">@item.StartAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                <h3><a href="/Events/@item.EventId">@item.Title</a></h3>
                <p class="muted">@item.CommunityName</p>
                <p>@item.Place</p>
                <div class="meta"><span class="badge">@item.Category</span><span>@item.Registered@(item.Capacity is not null ? $" / {item.Capacity}" : "") зарегистрировано</span></div>
                <p class="recommendation-reason">Почему рекомендуем: @item.Reason</p>
                <a class="button secondary" href="/Events/@item.EventId">Подробнее</a>
            </article>
        }
        </div>
    }
</section>

<section class="section">
    <div class="page-head mini">
        <div><h2>Ближайшие мероприятия</h2><p class="muted">Ваши активные регистрации.</p></div>
        <a class="link-button" href="/Events/Calendar">Открыть календарь</a>
    </div>
    @if (Model.Upcoming.Count == 0)
    {
        <div class="card empty-dashboard"><p>Ближайших регистраций пока нет.</p><a class="button" href="/Events">Посмотреть афишу</a></div>
    }
    else
    {
        <div class="cards dashboard-cards">
        @foreach (var item in Model.Upcoming)
        {
            <article class="card dashboard-event-card">
                <p class="eyebrow">@item.StartAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                <h3><a href="/Events/@item.EventId">@item.Title</a></h3>
                <p class="muted">@item.CommunityName</p>
                <p>@item.Place</p>
                <div class="meta"><span class="badge">@item.Status</span>@if (item.Latitude is not null && item.Longitude is not null) { <span>есть на карте</span> }</div>
                <div class="actions compact">
                    <a class="button" href="/Events/@item.EventId/Ticket">QR-билет</a>
                    <a class="button secondary" href="/Events/@item.EventId">Карточка</a>
                </div>
            </article>
        }
        </div>
    }
</section>

@if (Model.PerformerAssignments.Count > 0)
{
<section class="section">
    <h2>Я исполнитель</h2>
    <div class="cards dashboard-cards">
    @foreach (var item in Model.PerformerAssignments)
    {
        <article class="card">
            <p class="eyebrow">@item.StartAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
            <h3><a href="/Events/@item.EventId">@item.Title</a></h3>
            <p>@item.CommunityName · @item.Place</p>
            <span class="badge">@item.Role</span>
        </article>
    }
    </div>
</section>
}

@if (Model.ManagedCommunities.Count > 0)
{
<section class="section">
    <div class="page-head mini"><div><h2>Мои сообщества</h2><p class="muted">Сообщества, где у вас есть права управления.</p></div><a class="button secondary" href="/Communities/Create">Создать сообщество</a></div>
    <div class="cards dashboard-cards">
    @foreach (var community in Model.ManagedCommunities)
    {
        <article class="card">
            <p class="eyebrow">@community.Role</p>
            <h3><a href="/Communities/@community.Id">@community.Name</a></h3>
            <div class="meta"><span class="badge">@community.Status</span><span>@community.EventCount мероприятий</span><span>@community.MemberCount участников</span></div>
            <div class="actions compact">
                <a class="button secondary" href="/Communities/@community.Id">Открыть</a>
                @if (community.Role == "Owner") { <a class="button secondary" href="/Communities/@community.Id/Members">Администраторы</a> }
                <a class="button" href="/Events/Create?communityId=@community.Id">Новое мероприятие</a>
            </div>
        </article>
    }
    </div>
</section>
}

@if (Model.ManagedEvents.Count > 0)
{
<section class="section">
    <h2>Организаторские задачи</h2>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Мероприятие</th><th>Дата</th><th>Статус</th><th>Участники</th><th>Действия</th></tr></thead>
            <tbody>
            @foreach (var evt in Model.ManagedEvents)
            {
                <tr>
                    <td><strong>@evt.Title</strong><br/><span class="muted">@evt.CommunityName</span></td>
                    <td>@evt.StartAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td><span class="badge">@evt.Status</span></td>
                    <td>@evt.Registered@(evt.Capacity is not null ? $" / {evt.Capacity}" : "")<br/><span class="muted">пришли: @evt.Attended</span></td>
                    <td><div class="actions compact"><a class="link-button" href="/Events/@evt.Id/Manage">Управление</a><a class="link-button" href="/Events/@evt.Id/Analytics">Аналитика</a></div></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
}

<section class="section">
    <div class="page-head mini"><div><h2>История участия</h2><p class="muted">Последние мероприятия, в которых вы участвовали.</p></div></div>
    @if (Model.Past.Count == 0)
    {
        <p class="muted">История пока пустая.</p>
    }
    else
    {
        <div class="cards dashboard-cards">
        @foreach (var item in Model.Past)
        {
            <a class="card link-card" href="/Events/@item.EventId">
                <p class="eyebrow">@item.StartAt.ToLocalTime().ToString("dd.MM.yyyy")</p>
                <h3>@item.Title</h3>
                <p>@item.CommunityName</p>
                <span class="badge">@item.Status</span>
            </a>
        }
        </div>
    }
</section>
