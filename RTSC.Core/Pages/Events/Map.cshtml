@page "/Events/Map"
@using System.Text.Json
@model RTSC.Core.Pages.Events.MapModel
@{
    ViewData["Title"] = "Карта мероприятий";
    var json = JsonSerializer.Serialize(Model.Items, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<div class="page-head">
    <div><p class="eyebrow">Афиша</p><h1>Карта мероприятий</h1><p class="muted">На карте показаны опубликованные мероприятия, для которых организатор указал координаты.</p></div>
    <div class="actions"><a class="button secondary" href="/Events">Список</a><a class="button secondary" href="/Events/Calendar">Календарь</a></div>
</div>
<div id="events-map" class="events-map" aria-label="Карта мероприятий" data-points="@json"></div>
@if (Model.Items.Count == 0)
{
    <p class="muted">Пока нет ближайших мероприятий с координатами.</p>
}
else
{
    <p class="muted">Точек на карте: @Model.Items.Count</p>
}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="~/js/events-map.js"></script>
