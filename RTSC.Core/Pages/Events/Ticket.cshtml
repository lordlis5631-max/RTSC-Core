@page "/Events/{id:guid}/Ticket"
@model RTSC.Core.Pages.Events.TicketModel
@{
    ViewData["Title"] = "QR-билет";
}
<div class="ticket card"><p class="eyebrow">Персональный QR-билет</p><h1>@Model.EventTitle</h1><p>@Model.UserName</p><img class="qr" src="/api/checkin/ticket/@Model.Id/qr" alt="QR для отметки посещения"/><p class="muted">Покажите этот QR организатору. Организатор сканирует его обычной камерой телефона и подтверждает посещение.</p><a class="button secondary" href="/Events/@Model.Id">Назад к мероприятию</a></div>
