@page "/Events/{id:guid}/Manage"
@model RTSC.Core.Pages.Events.ManageModel
@{
    ViewData["Title"] = "Управление мероприятием";
}
<div class="page-head"><div><p class="eyebrow">Управление</p><h1>@Model.Title</h1><span class="badge">@Model.Status</span></div><div class="actions"><a class="button secondary" href="/Events/@Model.Id">Карточка мероприятия</a><a class="button secondary" href="/api/events/@Model.Id/participants.csv">Экспорт участников CSV</a></div></div>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <p class="notice">@Model.Message</p> }
@if (Model.Status == "Draft") { <form method="post" asp-page-handler="Submit" class="inline-form"><button class="button" type="submit">Отправить на модерацию</button></form> }
@if (Model.Status == "Published") { <form method="post" asp-page-handler="Complete" class="inline-form"><button class="button" type="submit">Завершить мероприятие</button></form> }
<section class="section"><h2>Исполнители</h2><form method="post" asp-page-handler="AddPerformer" class="row-form"><input asp-for="PerformerEmail" type="email" placeholder="Email пользователя" required /><input asp-for="PerformerRole" placeholder="Роль, например ведущий" /><button class="button" type="submit">Добавить</button></form><div class="table-wrap"><table><thead><tr><th>Имя</th><th>Email</th><th>Роль</th><th></th></tr></thead><tbody>@foreach (var p in Model.Performers) { <tr><td><a href="/Ratings/Performer/@p.UserId">@p.Name</a></td><td>@p.Email</td><td>@p.Role</td><td><form method="post" asp-page-handler="RemovePerformer"><input type="hidden" name="userId" value="@p.UserId"/><button class="link-button" type="submit">Убрать</button></form></td></tr> }</tbody></table></div></section>
<section class="section"><h2>Участники (@Model.Participants.Count)</h2><div class="table-wrap"><table><thead><tr><th>Участник</th><th>Email</th><th>Статус</th><th>Действия</th></tr></thead><tbody>@foreach (var p in Model.Participants) { <tr><td><a href="/Ratings/Participant/@p.UserId">@p.Name</a></td><td>@p.Email</td><td><span class="badge">@p.Status</span></td><td><div class="actions compact"><form method="post" asp-page-handler="ParticipantStatus"><input type="hidden" name="userId" value="@p.UserId"/><input type="hidden" name="status" value="Attended"/><button class="link-button" type="submit">Пришёл</button></form><form method="post" asp-page-handler="ParticipantStatus"><input type="hidden" name="userId" value="@p.UserId"/><input type="hidden" name="status" value="NoShow"/><button class="link-button" type="submit">Не пришёл</button></form></div>@if (p.Status == "Attended" && Model.Status == "Completed") { <form method="post" asp-page-handler="RateParticipant" class="participant-rating"><input type="hidden" name="userId" value="@p.UserId"/><select name="score"><option value="5">5</option><option value="4">4</option><option value="3">3</option><option value="2">2</option><option value="1">1</option></select><input name="comment" maxlength="4000" placeholder="Комментарий организатора"/><button class="link-button" type="submit">Оценить</button></form> }</td></tr> }</tbody></table></div></section>
