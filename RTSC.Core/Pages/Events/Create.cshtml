@page
@model RTSC.Core.Pages.Events.CreateModel
@{
    ViewData["Title"] = "Новое мероприятие";
}
<div class="page-head"><div><p class="eyebrow">Мероприятия</p><h1>Новое мероприятие</h1></div></div>
@if (!string.IsNullOrWhiteSpace(Model.Error)) { <p class="error">@Model.Error</p> }
@if (Model.Communities.Count == 0)
{
    <div class="card"><p>Сначала создайте сообщество, которым вы управляете.</p><a class="button" href="/Communities/Create">Создать сообщество</a></div>
}
else
{
<form method="post" class="form wide-form">
    <label>Сообщество<select asp-for="CommunityId">@foreach (var c in Model.Communities) { <option value="@c.Id">@c.Name</option> }</select></label>
    <label>Название<input asp-for="Title" maxlength="300" required /></label>
    <label>Описание<textarea asp-for="Description" rows="8"></textarea></label>
    <div class="form-grid">
        <label>Начало<input asp-for="StartAtLocal" type="datetime-local" required /></label>
        <label>Окончание<input asp-for="EndAtLocal" type="datetime-local" /></label>
    </div>
    <label>Место<input asp-for="Place" maxlength="500" /></label>
    <label>Лимит участников<input asp-for="Capacity" type="number" min="1" /></label>
    <div class="form-grid">
        <label>Регистрация с<input asp-for="RegistrationStartLocal" type="datetime-local" /></label>
        <label>Регистрация до<input asp-for="RegistrationEndLocal" type="datetime-local" /></label>
    </div>
    <label>Ссылка на изображение<input asp-for="ImageUrl" type="url" /></label>
    <div class="actions"><button class="button" type="submit">Создать черновик</button><a class="button secondary" href="/Events">Отмена</a></div>
</form>
}
