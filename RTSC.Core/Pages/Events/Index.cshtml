@page
@model RTSC.Core.Pages.Events.IndexModel
@{
    ViewData["Title"] = "Мероприятия";
}
<div class="page-head">
    <div><p class="eyebrow">Афиша</p><h1>Мероприятия</h1></div>
    <div class="actions">
        <a class="button secondary" href="/Events/Map">Карта</a>
        @if (User.Identity?.IsAuthenticated == true) { <a class="button" href="/Events/Create">Создать мероприятие</a> }
    </div>
</div>

<form method="get" class="card event-filters">
    <div class="filter-grid">
        <label>Поиск<input asp-for="Q" placeholder="Название, описание, место или сообщество" /></label>
        <label>Сообщество
            <select asp-for="CommunityId">
                <option value="">Все сообщества</option>
                @foreach (var community in Model.Communities) { <option value="@community.Id">@community.Name</option> }
            </select>
        </label>
        <label>Место<input asp-for="Place" placeholder="Например, Уфа" /></label>
        <label>С даты<input asp-for="From" type="date" /></label>
        <label>По дату<input asp-for="To" type="date" /></label>
        <label class="check-label"><input asp-for="WithLocation" /> Только с координатами</label>
    </div>
    <div class="actions compact"><button class="button" type="submit">Найти</button><a class="button secondary" href="/Events">Сбросить</a></div>
</form>

<p class="muted result-count">Найдено мероприятий: @Model.Items.Count</p>
<div class="cards">
@foreach (var item in Model.Items)
{
    <a class="card link-card" href="/Events/@item.Id">
        <p class="eyebrow">@item.StartAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
        <h3>@item.Title</h3>
        <p>@item.Description</p>
        <p><strong>@item.Place</strong></p>
        <div class="meta"><span class="badge">@item.CommunityName</span><span>@item.Registered участников@if (item.Capacity is not null) { <text> / @item.Capacity</text> }</span>@if (item.HasLocation) { <span>📍 На карте</span> }</div>
    </a>
}
@if (Model.Items.Count == 0) { <p class="muted">По выбранным условиям мероприятий не найдено.</p> }
</div>
