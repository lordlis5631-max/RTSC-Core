@page "/Ratings/Participant/{userId:guid}"
@model RTSC.Core.Pages.Ratings.ParticipantModel
@{ ViewData["Title"] = "Рейтинг участника"; }
@if (Model.Profile is null) { <h1>Профиль не найден</h1> }
else { <div class="profile-hero card"><p class="eyebrow">Участник мероприятий</p><h1>@Model.Profile.Name</h1><div class="big-rating">@(Model.Profile.Average is null ? "—" : $"★ {Model.Profile.Average.Value:0.00}")</div><p class="muted">@Model.Profile.Ratings оценок · @Model.Profile.Events мероприятий в расчёте</p></div><section class="section"><h2>Последние мероприятия</h2><div class="stack">@foreach (var e in Model.Events) { <article class="card"><div class="page-head mini"><div><h3><a href="/Events/@e.EventId">@e.Title</a></h3><p class="muted">@e.Date.ToLocalTime().ToString("dd.MM.yyyy") · @e.Ratings оценок</p></div><span class="rating-chip">★ @e.Average.ToString("0.00")</span></div></article> }</div></section>@if (Model.Comments.Count > 0) { <section class="section"><h2>Комментарии организаторов</h2><div class="stack">@foreach (var c in Model.Comments) { <article class="card"><p>@c.Text</p><p class="muted">@c.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</p></article> }</div></section> } }
