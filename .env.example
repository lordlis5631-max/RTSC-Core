# Local Docker defaults to Development so http://localhost:8080 works with browser cookies.
# For production set Production only when RTSC-Core is served through HTTPS reverse proxy.
ASPNETCORE_ENVIRONMENT=Development

POSTGRES_PASSWORD=change-me

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
BOOTSTRAP_ADMIN_NAME=Super Admin

# Public HTTPS address of RTSC-Core for production integrations.
PUBLIC_BASE_URL=https://rtsc.example.ru

# MAX bot settings.
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_URL=https://rtsc.example.ru/api/integrations/max/webhook
MAX_BOT_URL=

# Telegram bot settings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://rtsc.example.ru/api/integrations/telegram/webhook
TELEGRAM_BOT_URL=https://t.me/your_bot

# VK community bot settings.
VK_BOT_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
VK_CALLBACK_SECRET=
VK_CONFIRMATION_CODE=
VK_CALLBACK_URL=https://rtsc.example.ru/api/integrations/vk/callback
VK_BOT_URL=https://vk.me/your_community
